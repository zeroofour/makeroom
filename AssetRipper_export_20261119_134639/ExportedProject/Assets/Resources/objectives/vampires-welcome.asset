  m_Name: vampires-welcome
  m_EditorClassIdentifier:
  title: Vampires welcome
  type: 0
  cleaning: 0
  unlock: bat-wall-decoration (%wall)
  unlockName: Hanging bat
  chapters:
  - text: Ack! It's much too bright in here, can you please remove the windows?
    hint:
    prompt:
    name: Windows
    action:
    count: 0
    objects:
    - tagsPositive: window
      tagsNegative:
  - text: Hm, I'd still have to see my victim... I mean friend. Can you add a lamp or two?
    hint:
    prompt:
    name: Lamps
    action:
    count: 2
    objects:
    - tagsPositive: lamp
      tagsNegative:
  - text: I think having a cat is nice companionship, can you place a cat somewhere?
    hint:
    prompt:
    name: Cat
    action:
    count: 1
    objects:
    - tagsPositive: cat
      tagsNegative:
  - text: I love my furry friend! Now place a mirror somewhere, for dramatic effect!
    hint:
    prompt:
    name: Mirror
    action:
    count: 1
    objects:
    - tagsPositive: mirror
      tagsNegative:
