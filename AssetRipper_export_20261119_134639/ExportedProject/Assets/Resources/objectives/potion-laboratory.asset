--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0aca04db26949e7e4e559fdcf6beaca8, type: 3}
  m_Name: potion-laboratory
  m_EditorClassIdentifier:
  title: Potion laboratory
  type: 0
  cleaning: 1
  unlock: potion-square
  unlockName: Potion
  chapters:
  - text: Let's transform this room into a magical potion-making laboratory! The room needs cleaning first, the cobwebs might be a good start!
    hint: cleaning/duster
    prompt:
    name: Cobwebs
    action:
    count: 0
    objects:
    - tagsPositive: cobweb
      tagsNegative:
  - text: That's a lot better! There's still a few puddles of mud on the floor, we should clean that!
    hint: cleaning/mop
    prompt:
    name: Puddles
    action:
    count: 0
    objects:
    - tagsPositive: puddle
      tagsNegative:
  - text: Fantastic job! Now we can start decorating. First, a fireplace for brewing potions!
    hint:
    prompt:
    name: Fireplace
    action:
    count: 1
    objects:
    - tagsPositive: fireplace
      tagsNegative:
  - text: Great choice! Now, lets light the fireplace by placing a fire effect!
    hint:
    prompt:
    name: Fire
    action:
    count: 1
    objects:
    - tagsPositive: fire
      tagsNegative: fireplace
  - text: But what if the fire goes out? We'll need some additional logs!
    hint:
    prompt:
    name: Logs
    action:
    count: 2
    objects:
    - tagsPositive: logs
      tagsNegative:
  - text: Wonderful! How about we add some jars to the fireplace mantle?
    hint:
    prompt:
    name: Jars
    action:
    count: 4
    objects:
    - tagsPositive: jar
      tagsNegative:
    - tagsPositive: potion
      tagsNegative:
  - text: Now lets get rid of those curtains, they're a fire hazard with all the brewing going on!
    hint:
    prompt:
    name: Curtains
    action:
    count: 0
    objects:
    - tagsPositive: curtain
      tagsNegative:
  - text: Fantastic! Now, let's bring in the most enchanted creature of them all - a cat!
    hint:
    prompt:
    name: Cat
    action:
    count: 1
    objects:
    - tagsPositive: cat
      tagsNegative:
  - text: Amazing! To complete the magical laboratory, let's add some candles for that mysterious vibe.
    hint:
    prompt:
    name: Candles
    action:
    count: 2
    objects:
    - tagsPositive: candle
      tagsNegative:
