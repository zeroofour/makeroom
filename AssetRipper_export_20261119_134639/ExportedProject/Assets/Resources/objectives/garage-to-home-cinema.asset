  m_Script: {fileID: 11500000, guid: 0aca04db26949e7e4e559fdcf6beaca8, type: 3}
  m_Name: garage-to-home-cinema
  m_EditorClassIdentifier:
  title: Garage to home cinema
  type: 0
  cleaning: 1
  unlock: tv-large-curved
  unlockName: Curved TV
  chapters:
  - text: Let's start by tidying up! First, let's take care of those puddles of water.
    hint: cleaning/mop
    prompt:
    name: Puddles
    action:
    count: 0
    objects:
    - tagsPositive: puddle
      tagsNegative:
  - text: Great job so far! Now, let's grab the vacuum and make these floors so clean you could have a picnic on them!
    hint: cleaning/vacuum
    prompt:
    name: Dirt
    action:
    count: 0
    objects:
    - tagsPositive: dirt
      tagsNegative:
  - text: There are still a few cobwebs around - let's clean those up too!
    hint: cleaning/duster
    prompt:
    name: Cobwebs
    action:
    count: 0
    objects:
    - tagsPositive: cobweb
      tagsNegative:
  - text: How about we turn this messy garage into a cozy home theater? Let's clear up the space first!
    hint:
    prompt:
    name: Boxes
    action:
    count: 0
    objects:
    - tagsPositive: box
      tagsNegative:
  - text: Awesome! How about we level up this space with a comfy couch?
    hint:
    prompt:
    name: Couch
    action:
    count: 1
    objects:
    - tagsPositive: sofa
      tagsNegative:
  - text: That's great, but what's a cinema without a colossal TV screen!
    hint:
    prompt:
    name: Television
    action:
    count: 1
    objects:
    - tagsPositive: tv
      tagsNegative: cabinet
  - text: How about adding a bonus chair for maximum comfort?
    hint:
    prompt:
    name: Chair
    action:
    count: 1
    objects:
    - tagsPositive: chair
      tagsNegative:
