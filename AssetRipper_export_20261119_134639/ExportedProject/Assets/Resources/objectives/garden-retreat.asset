--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0aca04db26949e7e4e559fdcf6beaca8, type: 3}
  m_Name: garden-retreat
  m_EditorClassIdentifier:
  title: Garden retreat
  type: 0
  cleaning: 0
  unlock: watering-can
  unlockName: Watering can
  chapters:
  - text: What a tranquil garden! Let's get rid of those mushrooms in the flowerbed.
    hint:
    prompt:
    name: Mushrooms
    action:
    count: 0
    objects:
    - tagsPositive: mushroom
      tagsNegative:
  - text: Fantastic job! I think we should add some flowers to the flowerbed just to brighten it up!
    hint:
    prompt:
    name: Flowers
    action:
    count: 4
    objects:
    - tagsPositive: flower
      tagsNegative: flowerbed
  - text: You're doing excellent! It would be great to have a place to sit, start by finding two comfortable chairs for outdoor use.
    hint:
    prompt:
    name: Chairs
    action:
    count: 2
    objects:
    - tagsPositive: chair
      tagsNegative:
  - text: Great! Now a table to put down glasses of lemonade.
    hint:
    prompt:
    name: Table
    action:
    count: 1
    objects:
    - tagsPositive: table
      tagsNegative:
  - text: Fantastic! I mentioned some lemonade and I could really use some right now. Place a few glasses.
    hint:
    prompt:
    name: Glasses
    action:
    count: 2
    objects:
    - tagsPositive: glass
      tagsNegative:
  - text: Refreshing! It would be great to have a bit of shade, so maybe we should plant a tree in our little garden.
    hint:
    prompt:
    name: Tree
    action:
    count: 1
    objects:
    - tagsPositive: tree
      tagsNegative:
  diorama:
