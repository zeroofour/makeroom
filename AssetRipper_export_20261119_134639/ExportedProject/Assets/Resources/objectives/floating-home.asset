  m_Script: {fileID: 11500000, guid: 0aca04db26949e7e4e559fdcf6beaca8, type: 3}
  m_Name: floating-home
  m_EditorClassIdentifier:
  title: Floating Home
  type: 0
  cleaning: 1
  unlock: toy-boat
  unlockName: Toy Boat
  chapters:
  - text: Let's give this old boat a glow-up so it's ready for summer! First things first, let's mop up the water before we start renovating.
    hint: cleaning/mop
    prompt:
    name: Puddles
    action:
    count: 0
    objects:
    - tagsPositive: puddle
      tagsNegative:
  - text: Wonderful! There's still some messy dirt around, grab the vacuum and swoosh it away!
    hint: cleaning/vacuum
    prompt:
    name: Dirt
    action:
    count: 0
    objects:
    - tagsPositive: dirt
      tagsNegative:
  - text: You're a cleaning expert! Now that the floor is sparkling, how about picking a fresh new color?
    hint:
    prompt:
    name: Floor color
    action: set-floor-color
    count: 0
    objects: []
  - text: It looks wonderful already! But that big mast blocks lots of light... maybe we can swap it for a smaller one or remove it?
    hint:
    prompt:
    name: Mast
    action: set-boat-mast
    count: 0
    objects: []
  - text: Maybe those candles should go too. Better safe than sorry, we don’t want any fiery surprises!
    hint:
    prompt:
    name: Candles
    action:
    count: 0
    objects:
    - tagsPositive: candle
      tagsNegative:
  - text: That bed seems a bit unnecessary for our summer boat, make some extra space by removing it all together.
    hint:
    prompt:
    name: Bed
    action:
    count: 0
    objects:
    - tagsPositive: bed
      tagsNegative:
  - text: With that space free, how about adding a big cozy sofa so friends can all sit together?
    hint:
    prompt:
    name: Sofa
    action:
    count: 1
    objects:
    - tagsPositive: sofa
      tagsNegative:
  - text: Um... do you think we could get rid of those fish? They’re a little too smelly to keep here.
    hint:
    prompt:
    name: Fish
    action:
    count: 0
    objects:
    - tagsPositive: mount-fish
      tagsNegative:
  - text: Perfect! Let's expand the kitchen by adding another cabinet for extra storage.
    hint:
    prompt:
    name: Cabinets
    action:
    count: 3
    objects:
    - tagsPositive: cabinet
      tagsNegative:
  - text: It'd be great to add a fridge, to keep drinks cool during those hot summer days at sea!
    hint:
    prompt:
    name: Fridge
    action:
    count: 1
    objects:
    - tagsPositive: fridge
      tagsNegative:
  - text: To finish things off, let's add a cute rocking chair. Placing it on the deck would be just perfect.
    hint:
    prompt:
    name: Rocking chair
    action:
    count: 1
    objects:
    - tagsPositive: chair-rocking
      tagsNegative:
