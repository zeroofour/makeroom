  m_Name: spy-headquarters
  m_EditorClassIdentifier:
  title: Spy headquarters
  type: 0
  cleaning: 0
  unlock: binoculars
  unlockName: Binoculars
  chapters:
  - text: Let's turn this room into a top-secret spy headquarters! We should get rid of these cabinets, they take up a lot of space.
    hint:
    prompt:
    name: Cabinets
    action:
    count: 0
    objects:
    - tagsPositive: cabinet-clothing
      tagsNegative:
  - text: Now find a sleek and stylish desk fit for a super-spy mastermind.
    hint:
    prompt:
    name: Desk
    action:
    count: 1
    objects:
    - tagsPositive: desk
      tagsNegative:
  - text: Great choice! Now, let's find a laptop to do super secret stuff on!
    hint:
    prompt:
    name: Laptop
    action:
    count: 1
    objects:
    - tagsPositive: laptop
      tagsNegative:
  - text: Excellent! It would be wise to add a headphone to the laptop, that way secret messages don't accidentally leak!
    hint:
    prompt:
    name: Headphones
    action:
    count: 1
    objects:
    - tagsPositive: headphones
      tagsNegative:
  - text: Now, a comfortable chair for long sessions of top secret stuff.
    hint:
    prompt:
    name: Chair
    action:
    count: 1
    objects:
    - tagsPositive: chair
      tagsNegative:
  - text: And just for some time off let's add an arcade cabinet!
    hint:
    prompt:
    name: Arcade
    action:
    count: 1
    objects:
    - tagsPositive: arcade
      tagsNegative:
