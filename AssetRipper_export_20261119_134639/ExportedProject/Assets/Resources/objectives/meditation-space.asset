  m_Name: meditation-space
  m_EditorClassIdentifier:
  title: Meditation space
  type: 0
  cleaning: 0
  unlock: yoga-mat
  unlockName: Yoga mat
  chapters:
  - text: Let's turn this room into a peaceful meditation space! Start by selecting a soft rug.
    hint:
    prompt:
    name: Rug
    action:
    count: 1
    objects:
    - tagsPositive: carpet
      tagsNegative:
  - text: Great choice! Now, let's add some cushions for comfortable seating during meditation sessions.
    hint:
    prompt:
    name: Cushions
    action:
    count: 4
    objects:
    - tagsPositive: pillow
      tagsNegative:
  - text: Wonderful! I'm sure it can get hot in here, how about placing a fan?
    hint:
    prompt:
    name: Fan
    action:
    count: 1
    objects:
    - tagsPositive: fan
      tagsNegative:
  - text: Excellent! Let's bring in some greenery with potted plants or a small indoor garden to add to the tranquil atmosphere.
    hint:
    prompt:
    name: Plants
    action:
    count: 3
    objects:
    - tagsPositive: plant
      tagsNegative:
  - text: Fantastic! Now, let's add some ambient lighting with candles.
    hint:
    prompt:
    name: Candles
    action:
    count: 3
    objects:
    - tagsPositive: candle
      tagsNegative:
  - text: Amazing! To complete the meditation space, let's add a radio for soothing music!
    hint:
    prompt:
    name: Radio
    action:
    count: 1
    objects:
    - tagsPositive: radio
      tagsNegative:
