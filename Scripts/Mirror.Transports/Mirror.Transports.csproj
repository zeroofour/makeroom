    <ProjectReference Include="../SimpleWebTransport/SimpleWebTransport.csproj" />
    <ProjectReference Include="../Mirror.BouncyCastle.Cryptography/Mirror.BouncyCastle.Cryptography.csproj" />
    <ProjectReference Include="../UnityEngine.UnityWebRequestModule/UnityEngine.UnityWebRequestModule.csproj" />
    <ProjectReference Include="../UnityEngine.CoreModule/UnityEngine.CoreModule.csproj" />
    <ProjectReference Include="../Telepathy/Telepathy.csproj" />
  </ItemGroup>
</Project>